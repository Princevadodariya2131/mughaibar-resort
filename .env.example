# .env.example — Mughaibar Fort Resort concept website
# Copy to .env.local for local overrides. Never commit secrets.
# All Vite VITE_* variables are public and visible in the browser bundle.

# Example: analytics measurement ID (only add if consent/privacy notice is in place)
# VITE_GA_MEASUREMENT_ID=

# Contact form. Public URL of a hosted form service (e.g. a Formspree-style endpoint). No secrets.
# If unset, the form does NOT pretend to send: it opens a prefilled email draft and a WhatsApp link.
# VITE_FORM_ENDPOINT=

# Staging only: show third-party (unlicensed) preview photos in a production build.
# VITE_ALLOW_UNLICENSED_IMAGES=true

# Example: map embed token (if replacing the map placeholder)
# VITE_MAP_TOKEN=
